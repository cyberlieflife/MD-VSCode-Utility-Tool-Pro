{
	"name": "hearts-of-iron-iv-utilities-pro",
	"displayName": "%hoi4modutilities.displayName%",
	"description": "钢铁雄心4模组工具扩展版",
	"version": "1.2.0",
	"author": "Cyberlieflife",
	"publisher": "Cyberlieflife",
	"license": "MIT",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberlieflife/MD-VSCode-Utility-Tool-Pro"
	},
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"mod",
		"paradox",
		"hoi",
		"Heart of Iron"
	],
	"activationEvents": [
		"onCustomEditor:mdhoi4utilities.dds",
		"onCustomEditor:mdhoi4utilities.tga",
		"onWebviewPanel:mdftpreview",
		"onWebviewPanel:mdworldmappreview",
		"workspaceContains:**/*.gfx",
		"workspaceContains:common/national_focus/*.txt",
		"workspaceContains:common/technologies/*.txt",
		"workspaceContains:events/*.txt",
		"workspaceContains:map/default.map",
		"workspaceContains:common/ideas/*.txt",
		"workspaceContains:common/characters/*.txt",
		"workspaceContains:common/decisions/*.txt",
		"workspaceContains:common/bop/*.txt"
	],
	"main": "./dist/extension.js",
	"browser": "./dist/web-extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"locale": "%hoi4modutilities.locale%",
	"contributes": {
		"configuration": [
			{
				"title": "%hoi4modutilities.section.gameAndMod%",
				"order": 1,
				"properties": {
					"mdHoi4Utilities.installPath": {
						"title": "%hoi4modutilities.installPath.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.installPath.desc%"
					},
					"mdHoi4Utilities.loadDlcContents": {
						"title": "%hoi4modutilities.loadDlcContents.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.loadDlcContents.desc%"
					},
					"mdHoi4Utilities.modFile": {
						"title": "%hoi4modutilities.modFile.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.modFile.desc%"
					},
					"mdHoi4Utilities.parentModPaths": {
						"title": "%hoi4modutilities.parentModPaths.title%",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "%hoi4modutilities.parentModPaths.desc%"
					},
					"mdHoi4Utilities.userDataPath": {
						"title": "%hoi4modutilities.userDataPath.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.userDataPath.desc%"
					}
				}
			},
			{
				"title": "%hoi4modutilities.section.previews%",
				"order": 2,
				"properties": {
					"mdHoi4Utilities.previewLocalisation": {
						"title": "%hoi4modutilities.previewLocalisation.title%",
						"type": "string",
						"default": "English",
						"enum": [
							"Brazilian Portuguese",
							"English",
							"French",
							"German",
							"Japanese",
							"Polish",
							"Russian",
							"Simplified Chinese",
							"Spanish"
						],
						"description": "%hoi4modutilities.previewLocalisation.desc%"
					},
					"mdHoi4Utilities.previewWheel": {
						"title": "%hoi4modutilities.previewWheel.title%",
						"type": "string",
						"default": "scroll",
						"enum": [
							"auto",
							"zoom",
							"scroll"
						],
						"enumDescriptions": [
							"%hoi4modutilities.previewWheel.enum.auto%",
							"%hoi4modutilities.previewWheel.enum.zoom%",
							"%hoi4modutilities.previewWheel.enum.scroll%"
						],
						"description": "%hoi4modutilities.previewWheel.desc%"
					},
					"mdHoi4Utilities.eventTreePreview": {
						"title": "%hoi4modutilities.eventTreePreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.eventTreePreview.desc%"
					},
					"mdHoi4Utilities.decisionPreview": {
						"title": "%hoi4modutilities.decisionPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.decisionPreview.desc%"
					},
					"mdHoi4Utilities.ideaPreview": {
						"title": "%hoi4modutilities.ideaPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.ideaPreview.desc%"
					},
					"mdHoi4Utilities.characterPreview": {
						"title": "%hoi4modutilities.characterPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.characterPreview.desc%"
					},
					"mdHoi4Utilities.bopPreview": {
						"title": "%hoi4modutilities.bopPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.bopPreview.desc%"
					},
					"mdHoi4Utilities.useConditionInFocus": {
						"title": "%hoi4modutilities.useConditionInFocus.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.useConditionInFocus.desc%"
					},
					"mdHoi4Utilities.focusTreeLayout": {
						"title": "%hoi4modutilities.focusTreeLayout.title%",
						"type": "string",
						"enum": [
							"standard",
							"gui"
						],
						"enumDescriptions": [
							"%hoi4modutilities.focusTreeLayout.enum.standard%",
							"%hoi4modutilities.focusTreeLayout.enum.gui%"
						],
						"default": "standard",
						"description": "%hoi4modutilities.focusTreeLayout.desc%"
					},
					"mdHoi4Utilities.focusTreePrerequisiteLines": {
						"title": "%hoi4modutilities.focusTreePrerequisiteLines.title%",
						"type": "string",
						"enum": [
							"available",
							"completed"
						],
						"enumDescriptions": [
							"%hoi4modutilities.focusTreePrerequisiteLines.enum.available%",
							"%hoi4modutilities.focusTreePrerequisiteLines.enum.completed%"
						],
						"default": "available",
						"description": "%hoi4modutilities.focusTreePrerequisiteLines.desc%"
					},
					"mdHoi4Utilities.inlayWindowGfxRoots": {
						"title": "Focus inlay window GFX roots",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "Workspace/mod-relative folders scanned first for the .gfx files focus inlay windows use (e.g. \"interface/scripted_gui\"). The whole interface/ folder is always scanned after them. An inlay_window_gfx_roots = { ... } list in the mod's .mod file adds to this."
					},
					"mdHoi4Utilities.focusOverlayGfxFiles": {
						"title": "%hoi4modutilities.focusOverlayGfxFiles.title%",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "%hoi4modutilities.focusOverlayGfxFiles.desc%"
					},
					"mdHoi4Utilities.decisionGfxFiles": {
						"title": "%hoi4modutilities.decisionGfxFiles.title%",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "%hoi4modutilities.decisionGfxFiles.desc%"
					},
					"mdHoi4Utilities.ideaPlaceholderIcon": {
						"title": "%hoi4modutilities.ideaPlaceholderIcon.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.ideaPlaceholderIcon.desc%"
					},
					"mdHoi4Utilities.characterTraitStructuralKeys": {
						"title": "%hoi4modutilities.characterTraitStructuralKeys.title%",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "%hoi4modutilities.characterTraitStructuralKeys.desc%"
					},
					"mdHoi4Utilities.modifierFormatFiles": {
						"title": "%hoi4modutilities.modifierFormatFiles.title%",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "%hoi4modutilities.modifierFormatFiles.desc%"
					},
					"mdHoi4Utilities.technologyGfxRoots": {
						"title": "Technology GFX roots",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "Workspace/mod-relative root folders to scan recursively for .gfx files used by the technology tree preview (e.g. \"interface/technologies\")."
					},
					"mdHoi4Utilities.technologyCountryIcons": {
						"title": "Technology: country icons",
						"type": "boolean",
						"default": true,
						"description": "Offer a country dropdown in the technology tree preview and draw each technology with the selected country's own icon when it has one, falling back to the generic icon. The list of countries is read from the GFX index, so it is empty while that index is off."
					},
					"mdHoi4Utilities.modifierInlayHint": {
						"title": "%hoi4modutilities.modifierInlayHint.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.modifierInlayHint.desc%"
					}
				}
			},
			{
				"title": "%hoi4modutilities.section.worldMap%",
				"order": 3,
				"properties": {
					"mdHoi4Utilities.enableSupplyArea": {
						"title": "%hoi4modutilities.enableSupplyArea.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.enableSupplyArea.desc%"
					},
					"mdHoi4Utilities.worldMapRetainContextWhenHidden": {
						"title": "World map: keep webview in memory when hidden",
						"type": "boolean",
						"default": true,
						"description": "Keep the world map preview's webview loaded while the tab is hidden (faster to switch back, uses more memory). Turn off to free the webview when hidden and reload it on return, lowering memory use on large maps. The extension-host copy of the map is always released while hidden."
					}
				}
			},
			{
				"title": "%hoi4modutilities.section.indexes%",
				"order": 4,
				"properties": {
					"mdHoi4Utilities.sharedFocusIndex": {
						"title": "%hoi4modutilities.sharedFocusIndex.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.sharedFocusIndex.desc%"
					},
					"mdHoi4Utilities.ideaSwapIndex": {
						"title": "%hoi4modutilities.ideaSwapIndex.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.ideaSwapIndex.desc%"
					},
					"mdHoi4Utilities.gfxIndex": {
						"title": "%hoi4modutilities.gfxIndex.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.gfxIndex.desc%"
					},
					"mdHoi4Utilities.localisationIndex": {
						"title": "%hoi4modutilities.localisationIndex.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.localisationIndex.desc%"
					},
					"mdHoi4Utilities.imageDecodeWorkers": {
						"title": "%hoi4modutilities.imageDecodeWorkers.title%",
						"type": "number",
						"default": 4,
						"minimum": 1,
						"maximum": 16,
						"description": "%hoi4modutilities.imageDecodeWorkers.desc%"
					}
				}
			},
			{
				"title": "%hoi4modutilities.section.auditor%",
				"order": 5,
				"properties": {
					"mdHoi4Utilities.auditor.reportFolder": {
						"title": "%hoi4modutilities.auditor.reportFolder.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.auditor.reportFolder.desc%"
					},
					"mdHoi4Utilities.auditor.includeVanilla": {
						"title": "%hoi4modutilities.auditor.includeVanilla.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.auditor.includeVanilla.desc%"
					}
				}
			},
			{
				"title": "%hoi4modutilities.section.modTools%",
				"order": 6,
				"properties": {
					"mdHoi4Utilities.modTools.enabled": {
						"title": "%hoi4modutilities.modTools.enabled.title%",
						"type": "boolean",
						"default": false,
						"markdownDescription": "%hoi4modutilities.modTools.enabled.desc%"
					}
				}
			}
		],
		"commands": [
			{
				"command": "mdhoi4utilities.preview",
				"title": "%hoi4modutilities.preview.title%",
				"icon": {
					"dark": "static/preview_icon.png",
					"light": "static/preview_icon.png"
				},
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.selectmodfile",
				"title": "%hoi4modutilities.selectmodfile.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.previewworld",
				"title": "%hoi4modutilities.previewworld.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.scanreferences",
				"title": "%hoi4modutilities.scanreferences.title%",
				"icon": "$(references)",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.selecthoifolder",
				"title": "%hoi4modutilities.selecthoifolder.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.showindexstatus",
				"title": "%hoi4modutilities.showindexstatus.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.auditfocustrees",
				"title": "%hoi4modutilities.auditfocustrees.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.runmodtool",
				"title": "%hoi4modutilities.runmodtool.title%",
				"category": "%hoi4modutilities.category%"
			}
		],
		"customEditors": [
			{
				"viewType": "mdhoi4utilities.dds",
				"displayName": "%hoi4modutilities.dds.editorName%",
				"selector": [
					{
						"filenamePattern": "*.dds"
					}
				]
			},
			{
				"viewType": "mdhoi4utilities.tga",
				"displayName": "%hoi4modutilities.tga.editorName%",
				"selector": [
					{
						"filenamePattern": "*.tga"
					}
				]
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "mdhoi4utilities.preview",
					"when": "shouldShowMdHoi4Preview && resourceScheme != webview-panel",
					"group": "navigation"
				},
				{
					"command": "mdhoi4utilities.scanreferences",
					"when": "mdHoi4PreviewType == event && resourceScheme != webview-panel",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "mdhoi4utilities.preview",
					"when": "!shouldHideMdHoi4Preview && resourceScheme != webview-panel"
				},
				{
					"command": "mdhoi4utilities.scanreferences",
					"when": "!mdHoi4MULoaded || mdHoi4PreviewType == event"
				},
				{
					"command": "mdhoi4utilities.selectmodfile"
				},
				{
					"command": "mdhoi4utilities.previewworld"
				},
				{
					"command": "mdhoi4utilities.selecthoifolder"
				},
				{
					"command": "mdhoi4utilities.showindexstatus"
				},
				{
					"command": "mdhoi4utilities.auditfocustrees"
				},
				{
					"command": "mdhoi4utilities.runmodtool",
					"when": "mdHoi4ModToolsAvailable"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch --progress",
		"web-ext": "serve --cors -l 5000 --ssl-cert \"%CERT_PATH%/localhost.cer\" --ssl-key \"%CERT_PATH%/localhost.key\"",
		"compile-ts": "tsc -d -p ./ --module commonjs",
		"compile-test": "tsc -p ./tsconfig.test.json",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"compile-test-webview": "tsc -p ./tsconfig.webview.test.json",
		"pretest": "node scripts/compile-tests.js",
		"test": "mocha --exit --forbid-only --require ./out-test/src/test/_vscode_stub.js \"./out-test/src/test/**/*.test.js\" \"./out-test-webview/src/test/webview/**/*.test.js\"",
		"clean": "rimraf dist out static out-test out-test-webview",
		"geni18n": "npm run compile-ts && node scripts/genzhi18n.js",
		"bench": "npm run compile-test && node scripts/bench.js",
		"smoke:webviews": "node scripts/smoke-webviews.js",
		"compat": "node scripts/compile-tests.js && node --require ./out-test/src/test/_vscode_stub.js out-test/src/test/compat/runcompat.js",
		"vanilla-manifest": "node scripts/vanilla-manifest.js",
		"package": "vsce package",
		"package:patch": "npm version patch --no-git-tag-version && vsce package",
		"package:minor": "npm version minor --no-git-tag-version && vsce package",
		"package:major": "npm version major --no-git-tag-version && vsce package"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.4.33",
		"@types/copy-webpack-plugin": "^8.0.0",
		"@types/js-yaml": "^3.12.5",
		"@types/jsdom": "^28.0.3",
		"@types/lodash": "^4.14.149",
		"@types/mocha": "^7.0.2",
		"@types/node": "^20",
		"@types/pngjs": "^3.4.2",
		"@types/vscode": "~1.74.0",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@vscode/vsce": "^3.9.2",
		"copy-webpack-plugin": "^9.1.0",
		"eslint": "^10.1.0",
		"jsdom": "^29.1.1",
		"mocha": "^11.1.0",
		"raw-loader": "^4.0.1",
		"rimraf": "^6.1.3",
		"serve": "^14.2.0",
		"terser-webpack-plugin": "^5.3.11",
		"ts-loader": "^9.4.1",
		"tslib": "^2.2.0",
		"typescript": "^6.0.3",
		"webpack": "^5.94.0",
		"webpack-cli": "^4.7.0"
	},
	"dependencies": {
		"@vscode/codicons": "^0.0.33",
		"adm-zip": "^0.4.14",
		"assert": "^2.0.0",
		"browserify-zlib": "^0.2.0",
		"buffer": "^6.0.3",
		"js-yaml": "^3.14.0",
		"lodash": "^4.17.21",
		"path-browserify": "^1.0.1",
		"pngjs": "^5.0.0",
		"process": "^0.11.10",
		"rxjs": "^6.6.3",
		"stream-browserify": "^3.0.0",
		"tga": "^1.0.4",
		"url": "^0.11.0",
		"util": "^0.12.5"
	}
}
